# Copy this file to .env for local development and fill in your own key.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: override the Groq model. Defaults to openai/gpt-oss-120b.
# Check https://console.groq.com/docs/deprecations if a model call starts
# returning 404 model_not_found -- Groq deprecates/rotates free-tier models.
# GROQ_MODEL=openai/gpt-oss-120b

# Comma-separated list of origins allowed to call this API.
# For local dev the Next.js default is http://localhost:3000
# For production, set this to your deployed Vercel URL.
ALLOWED_ORIGINS=http://localhost:3000
